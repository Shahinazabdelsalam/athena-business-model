# Copiez ce fichier en .env pour le développement local.

# Base de données. En local, laissez vide pour utiliser SQLite.
# Sur Railway, cette variable est fournie automatiquement par le service Postgres.
DATABASE_URL=

# Clé secrète pour signer les sessions. Générez-en une :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez-moi-en-production
