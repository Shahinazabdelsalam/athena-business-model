# Copiez ce fichier en .env pour le développement local.

# Base de données. En local, laissez vide pour utiliser SQLite.
# Sur Railway, cette variable est fournie automatiquement par le service Postgres.
DATABASE_URL=

# Clé secrète pour signer les sessions. Générez-en une :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez-moi-en-production

# ---- Connexion Google OAuth ----
# 1. Allez sur https://console.cloud.google.com/
# 2. Créez un projet → API & Services → Identifiants → ID client OAuth 2.0
# 3. Type d'application : Application Web
# 4. URI de redirection autorisée : https://votre-domaine.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optionnel : forcez l'URI de callback (utile derrière un proxy Railway).
# Si vide, l'URI est déduite automatiquement de la requête.
GOOGLE_REDIRECT_URI=

# ---- Administration ----
# Email de l'administratrice — seule cette adresse peut accéder à /admin.
ADMIN_EMAIL=votre-email@exemple.fr
